{
  "name": "jerome",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "version:info": "tsx scripts/lib/version.ts",
    "lint": "node --import tsx ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node --import tsx ./node_modules/eslint/bin/eslint.js . --fix --max-warnings 0",
    "lint:atomic:fix": "bash src/scripts/eslint-fix-atomic.sh",
    "lint:types": "tsc -b",
    "lint:docs": "markdownlint \"design-system/**/*.md\" \"docs/**/*.md\" \"README.md\"",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy:infra": "npm install --prefix infrastructure && npm run deploy --prefix infrastructure",
    "bootstrap:infra": "npm install --prefix infrastructure && npm run bootstrap --prefix infrastructure",
    "deploy:site": "node scripts/deploy-site.mjs",
    "deploy": "npm run deploy:infra && npm run deploy:site",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "node scripts/build-storybook.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.893.0",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "mixpanel-browser": "^2.80.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.2.1",
    "eslint-plugin-atomic-structure": "file:eslint-plugin-atomic-structure",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli": "^0.45.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.9",
    "storybook": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "eslint-plugin-storybook": "^10.4.6",
    "playwright": "^1.61.1",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9"
  }
}
