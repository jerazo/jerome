# Copy to .env.local for local `npm run dev`
CLICKUP_API_TOKEN=pk_your_personal_api_token
CLICKUP_LIST_ID=your_clickup_list_id

# Contact access notifications (email when someone requests masked contact details)
NOTIFY_EMAIL=jerome.erazo@gmail.com
SES_FROM_EMAIL=jerome.erazo@gmail.com
CONTACT_ACCESS_OTP_SECRET=change-me-in-production

# AWS deploy (used by `npm run deploy:infra`)
# Requires AWS CLI credentials and CDK bootstrap in the target account/region.
# CLICKUP_* are injected into the contact Lambda at deploy time.
# CDK_DEFAULT_ACCOUNT=
# CDK_DEFAULT_REGION=us-east-1

# Optional: override contact endpoint in non-AWS previews
# VITE_CONTACT_API_URL=/api/contact

# Public site URL for SEO meta tags, sitemap, and robots.txt (also set in GitHub Actions as SITE_URL)
# VITE_SITE_URL=https://monx.dev

# CloudFront custom domain (us-east-1 ACM cert; also set in GitHub Actions for CDK deploy)
# SITE_DOMAIN_NAMES=monx.dev,www.monx.dev
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERT_ID
# SITE_URL=https://monx.dev

# Mixpanel project token (client-side analytics; leave unset to disable)
# VITE_MIXPANEL_TOKEN=your_mixpanel_project_token

# GitHub Actions reads stack outputs from CloudFormation when cdk-outputs.json is absent
# AWS_STACK_NAME=JeromeStack
